CLEANUP_CRON=0 4 1 * *
CLEANUP_AFTER_DAYS=30
MAX_UPLOAD_MB=50
# Google Drive backup (see README). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BACKUP_PASSPHRASE=
