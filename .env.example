APP_PASSWORD=change-me
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backup
BACKUP_KEEP=14
# How often the full backup runs is set in Menu → Backup & Restore (default every day). BACKUP_AUTO=off stops it.
# Unused pictures: checked monthly, removed once unused this many days and older than every kept backup.
CLEANUP_CRON=0 4 1 * *
CLEANUP_AFTER_DAYS=30
MAX_UPLOAD_MB=50
# Google Drive backup (see README). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BACKUP_PASSPHRASE=
